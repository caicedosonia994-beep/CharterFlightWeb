<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://Java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://Java.sun.com/xml/ns/javaee
                             http://Java.sun.com/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>Charter Flight Web</display-name>

    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.charterflight.filtro.CorsFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>ClienteServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.ClienteServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ClienteServlet</servlet-name>
        <url-pattern>/ClienteServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClienteApiServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.ClienteApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ClienteApiServlet</servlet-name>
        <url-pattern>/api/clientes/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VueloApiServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.VueloApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VueloApiServlet</servlet-name>
        <url-pattern>/api/vuelos/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReservaApiServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.ReservaApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ReservaApiServlet</servlet-name>
        <url-pattern>/api/reservas/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PagoApiServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.PagoApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PagoApiServlet</servlet-name>
        <url-pattern>/api/pagos/*</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>SolicitudEspecialApiServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.SolicitudEspecialApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SolicitudEspecialApiServlet</servlet-name>
        <url-pattern>/api/solicitudes-especiales/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BackofficeApiServlet</servlet-name>
        <servlet-class>com.charterflight.servlet.BackofficeApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>BackofficeApiServlet</servlet-name>
        <url-pattern>/api/operaciones-cobrables/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>BackofficeApiServlet</servlet-name>
        <url-pattern>/api/reportes/*</url-pattern>
    </servlet-mapping>
</web-app>
